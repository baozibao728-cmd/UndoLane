{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "skipLibCheck": true, "jsx": "react-jsx"
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "*.config.ts"]
}
